@@ -0,0 +1,103 @@
+import hashlib
+import json
+from pathlib import Path
+import re
+import time
+from types import SimpleNamespace
+from urllib.parse import urljoin, urlsplit
+
+from bs4 import BeautifulSoup
+import requests
+from selenium.common.exceptions import NoSuchElementException
+
+
+def form_fields(form):
+    fields = {item["name"]: item.get("value", "") for item in form.select("input[name]")
+              if not item.has_attr("disabled")}
+    for select in form.select("select[name]"):
+        option = select.find("option", selected=True) or select.find("option")
+        if option:
+            fields[select["name"]] = option.get("value", option.get_text())
+    return fields
+
+
+class HTTPDriver:
+    def __init__(self, args, folder, check_page):
+        self.args = args
+        self.folder = Path(folder)
+        self.check_page = check_page
+        self.session = requests.Session()
+        self.session.headers["User-Agent"] = args.user_agent
+        self.last_request = 0
+        self.page_source = ""
+        self.current_url = ""
+
+    def request(self, method, url, data=None):
+        for _ in range(4):
+            parts = urlsplit(url)
+            if (parts.scheme != "https" or parts.hostname != "xiaoxue.iis.sinica.edu.tw"
+                    or parts.port not in (None, 443) or parts.username is not None):
+                raise RuntimeError("停止访问非官方 HTTPS 地址")
+            if getattr(self.args, "robots", None) and not self.args.robots.can_fetch(self.args.user_agent, url):
+                raise RuntimeError("robots 不允许查询表单地址")
+            time.sleep(max(0, self.args.interval - (time.monotonic() - self.last_request)))
+            self.last_request = time.monotonic()
+            response = self.session.request(method, url, data=data, timeout=25, allow_redirects=False)
+            digest = hashlib.sha256(response.content).hexdigest()
+            raw = self.folder / "raw" / f"http-{digest}.html"
+            raw.parent.mkdir(parents=True, exist_ok=True)
+            raw.write_bytes(response.content)
+            entry = {"method": method, "url": url, "fields": data,
+                     "status_code": response.status_code, "sha256": digest, "path": str(raw)}
+            with (self.folder / "requests.jsonl").open("a", encoding="utf-8") as handle:
+                handle.write(json.dumps(entry, ensure_ascii=False) + "\n")
+            self.check_page(response.text)
+            if response.status_code in (301, 302, 303, 307, 308):
+                url = urljoin(url, response.headers["Location"])
+                if response.status_code in (301, 302, 303):
+                    method, data = "GET", None
+                continue
+            response.raise_for_status()
+            if "html" not in response.headers.get("Content-Type", "").lower():
+                raise RuntimeError("查询返回非 HTML 内容")
+            self.page_source = response.text
+            self.current_url = url
+            return
+        raise RuntimeError("查询重定向超过上限")
+
+    def get(self, url):
+        self.request("GET", url)
+        soup = BeautifulSoup(self.page_source, "lxml")
+        form = soup.find("form", id="BasicFrom")
+        if form is not None and not soup.select("td.VariantListA img, td.VariantListB img"):
+            action = urljoin(self.current_url, form["action"])
+            if form.get("method", "get").lower() != "post":
+                raise RuntimeError("查询表单方法变化，停止采集")
+            self.request("POST", action, form_fields(form))
+
+    def find_element(self, *args):
+        soup = BeautifulSoup(self.page_source, "lxml")
+        links = [link for link in soup.select("a.Bookmarker") if link.get_text(strip=True) == "下一頁"]
+        if not links:
+            raise NoSuchElementException("No next page")
+        targets = {link.get("id", "") for link in links}
+        if len(targets) != 1:
+            raise RuntimeError("分页结构异常：下一页目标不一致")
+        match = re.fullmatch(r"PageLink(\d+)", targets.pop())
+        form = soup.find("form", id="HiddenFrom")
+        if not match or form is None or form.get("method", "").lower() != "post":
+            raise RuntimeError("分页结构异常：缺少已验证的翻页表单")
+        fields = form_fields(form)
+        target = int(match[1])
+        current = fields.get("PageTo", "")
+        if not current.isdecimal() or target != int(current) + 1:
+            raise RuntimeError("分页结构异常：下一页不连续")
+        fields["PageTo"] = str(target)
+        action = urljoin(self.current_url, form["action"])
+        return SimpleNamespace(click=lambda: self.request("POST", action, fields))
+
+    def set_page_load_timeout(self, timeout):
+        pass
+
+    def quit(self):
+        self.session.close()
